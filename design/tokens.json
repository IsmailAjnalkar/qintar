{
  "$meta": {
    "name": "Qintar Design Tokens",
    "version": "0.1.0",
    "owner": "UXDesigner",
    "format": "design-tokens-community-group",
    "notes": "v0 token set for Qintar W1. Source of truth. Generate CSS/TS via build step or copy tokens.css."
  },

  "color": {
    "base": {
      "ink":   { "0": "#0B0F1E", "1": "#111634", "2": "#1A2147", "3": "#2A335E", "4": "#4A547A", "5": "#737C9C", "6": "#A4ABC2", "7": "#C9CEDD", "8": "#E2E5EE", "9": "#F2F3F8", "10": "#FFFFFF" },
      "indigo": { "50": "#EEF0FF", "100": "#DCE0FF", "200": "#B7BFFF", "300": "#8B97FF", "400": "#5F6FFF", "500": "#3B40E0", "600": "#2E2FB8", "700": "#252595", "800": "#1B1B72", "900": "#13134F" },
      "amber":  { "50": "#FFF7E6", "100": "#FFE9B8", "200": "#FFD877", "300": "#FFC23A", "400": "#F5A800", "500": "#D18B00", "600": "#A06800", "700": "#704800" },
      "mint":   { "50": "#E6FBF2", "100": "#C2F4DD", "200": "#8AE7BD", "300": "#52D69D", "400": "#1FBE7E", "500": "#0D9D66", "600": "#077A4F", "700": "#055438" },
      "coral":  { "50": "#FEECEC", "100": "#FBD0D0", "200": "#F5A1A1", "300": "#EE7373", "400": "#E64545", "500": "#C92A2A", "600": "#9F1F1F", "700": "#741515" }
    },
    "semantic": {
      "bg":               { "value": "{color.base.ink.10}", "comment": "Page background, light mode" },
      "bg.subtle":        { "value": "{color.base.ink.9}",  "comment": "Section bands, large surfaces" },
      "bg.muted":         { "value": "{color.base.ink.8}",  "comment": "Cards on subtle bg, dividers" },
      "bg.inverse":       { "value": "{color.base.ink.0}",  "comment": "Dark surfaces, footers, code blocks" },
      "surface":          { "value": "{color.base.ink.10}", "comment": "Card / modal surface" },
      "surface.raised":   { "value": "{color.base.ink.10}", "comment": "Floating UI (tooltip, popover)" },
      "border":           { "value": "{color.base.ink.8}",  "comment": "Default 1px hairline" },
      "border.strong":    { "value": "{color.base.ink.7}",  "comment": "Form fields, table outline" },
      "border.focus":     { "value": "{color.base.indigo.500}", "comment": "Focus ring color" },

      "text":             { "value": "{color.base.ink.1}",  "comment": "Body / primary" },
      "text.muted":       { "value": "{color.base.ink.4}",  "comment": "Secondary copy, captions" },
      "text.subtle":      { "value": "{color.base.ink.5}",  "comment": "Helper text, placeholders" },
      "text.inverse":     { "value": "{color.base.ink.10}", "comment": "On dark surfaces" },
      "text.link":        { "value": "{color.base.indigo.600}" },
      "text.brand":       { "value": "{color.base.indigo.500}" },

      "accent":           { "value": "{color.base.indigo.500}", "comment": "Primary brand accent" },
      "accent.hover":     { "value": "{color.base.indigo.600}" },
      "accent.active":    { "value": "{color.base.indigo.700}" },
      "accent.subtle":    { "value": "{color.base.indigo.50}" },

      "signal.urgent":    { "value": "{color.base.amber.400}", "comment": "Push today / time-sensitive" },
      "signal.urgent.bg": { "value": "{color.base.amber.50}" },
      "signal.positive":  { "value": "{color.base.mint.500}",  "comment": "Healthy, closed, on-track" },
      "signal.positive.bg":{"value": "{color.base.mint.50}" },
      "signal.risk":      { "value": "{color.base.coral.500}", "comment": "Stalled, at-risk" },
      "signal.risk.bg":   { "value": "{color.base.coral.50}" }
    }
  },

  "space": {
    "0":  "0px",
    "1":  "4px",
    "2":  "8px",
    "3":  "12px",
    "4":  "16px",
    "5":  "20px",
    "6":  "24px",
    "8":  "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px",
    "40": "160px",
    "48": "192px",
    "$comment": "4px base. NEVER use values outside this scale."
  },

  "radius": {
    "none": "0px",
    "xs":   "4px",
    "sm":   "6px",
    "md":   "8px",
    "lg":   "12px",
    "xl":   "16px",
    "2xl":  "24px",
    "full": "9999px"
  },

  "shadow": {
    "none":  "none",
    "xs":    "0 1px 2px 0 rgba(11, 15, 30, 0.04)",
    "sm":    "0 1px 3px 0 rgba(11, 15, 30, 0.06), 0 1px 2px -1px rgba(11, 15, 30, 0.04)",
    "md":    "0 4px 12px -2px rgba(11, 15, 30, 0.08), 0 2px 4px -2px rgba(11, 15, 30, 0.04)",
    "lg":    "0 12px 24px -6px rgba(11, 15, 30, 0.10), 0 4px 8px -4px rgba(11, 15, 30, 0.04)",
    "xl":    "0 24px 48px -12px rgba(11, 15, 30, 0.16)",
    "focus": "0 0 0 3px rgba(59, 64, 224, 0.32)"
  },

  "type": {
    "family": {
      "display": "'Geist', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "body":    "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono":    "'JetBrains Mono', 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": {
      "regular": "400",
      "medium":  "500",
      "semibold":"600",
      "bold":    "700"
    },
    "size": {
      "xs":   "12px",
      "sm":   "14px",
      "base": "16px",
      "md":   "18px",
      "lg":   "20px",
      "xl":   "24px",
      "2xl":  "30px",
      "3xl":  "36px",
      "4xl":  "44px",
      "5xl":  "56px",
      "6xl":  "72px"
    },
    "lineHeight": {
      "tight":   "1.1",
      "snug":    "1.25",
      "normal":  "1.5",
      "relaxed": "1.65"
    },
    "tracking": {
      "tight":  "-0.02em",
      "snugger":"-0.01em",
      "normal": "0",
      "wide":   "0.02em",
      "wider":  "0.08em"
    },
    "scale": {
      "display.xl":  { "size": "{type.size.6xl}",  "lineHeight": "{type.lineHeight.tight}", "weight": "{type.weight.semibold}", "tracking": "{type.tracking.tight}",   "family": "{type.family.display}" },
      "display.lg":  { "size": "{type.size.5xl}",  "lineHeight": "{type.lineHeight.tight}", "weight": "{type.weight.semibold}", "tracking": "{type.tracking.tight}",   "family": "{type.family.display}" },
      "display.md":  { "size": "{type.size.4xl}",  "lineHeight": "{type.lineHeight.tight}", "weight": "{type.weight.semibold}", "tracking": "{type.tracking.snugger}", "family": "{type.family.display}" },
      "heading.lg":  { "size": "{type.size.3xl}",  "lineHeight": "{type.lineHeight.snug}",  "weight": "{type.weight.semibold}", "tracking": "{type.tracking.snugger}", "family": "{type.family.display}" },
      "heading.md":  { "size": "{type.size.2xl}",  "lineHeight": "{type.lineHeight.snug}",  "weight": "{type.weight.semibold}", "tracking": "{type.tracking.snugger}", "family": "{type.family.display}" },
      "heading.sm":  { "size": "{type.size.xl}",   "lineHeight": "{type.lineHeight.snug}",  "weight": "{type.weight.semibold}", "tracking": "{type.tracking.normal}",  "family": "{type.family.display}" },
      "body.lg":     { "size": "{type.size.lg}",   "lineHeight": "{type.lineHeight.relaxed}","weight": "{type.weight.regular}", "tracking": "{type.tracking.normal}",  "family": "{type.family.body}" },
      "body.md":     { "size": "{type.size.base}", "lineHeight": "{type.lineHeight.normal}", "weight": "{type.weight.regular}", "tracking": "{type.tracking.normal}",  "family": "{type.family.body}" },
      "body.sm":     { "size": "{type.size.sm}",   "lineHeight": "{type.lineHeight.normal}", "weight": "{type.weight.regular}", "tracking": "{type.tracking.normal}",  "family": "{type.family.body}" },
      "label":       { "size": "{type.size.sm}",   "lineHeight": "{type.lineHeight.snug}",  "weight": "{type.weight.medium}",   "tracking": "{type.tracking.normal}",  "family": "{type.family.body}" },
      "eyebrow":     { "size": "{type.size.xs}",   "lineHeight": "{type.lineHeight.snug}",  "weight": "{type.weight.semibold}", "tracking": "{type.tracking.wider}",   "family": "{type.family.body}" },
      "caption":     { "size": "{type.size.xs}",   "lineHeight": "{type.lineHeight.normal}", "weight": "{type.weight.regular}", "tracking": "{type.tracking.normal}",  "family": "{type.family.body}" },
      "mono.sm":     { "size": "{type.size.sm}",   "lineHeight": "{type.lineHeight.normal}", "weight": "{type.weight.medium}",   "tracking": "{type.tracking.normal}",  "family": "{type.family.mono}" }
    }
  },

  "motion": {
    "duration": {
      "instant": "0ms",
      "micro":   "120ms",
      "short":   "200ms",
      "medium":  "320ms",
      "long":    "500ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "entrance": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "exit":     "cubic-bezier(0.4, 0.0, 1, 1)",
      "spring":   "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "$rule": "Doherty Threshold — any user-initiated transition must complete < 400ms or show progress"
  },

  "layout": {
    "container": {
      "max":      "1200px",
      "wide":     "1280px",
      "narrow":   "720px"
    },
    "breakpoint": {
      "sm":  "640px",
      "md":  "768px",
      "lg":  "1024px",
      "xl":  "1280px",
      "2xl": "1440px"
    },
    "grid": {
      "desktop.columns": 12,
      "desktop.gutter":  "{space.6}",
      "desktop.margin":  "{space.12}",
      "mobile.columns":  4,
      "mobile.gutter":   "{space.4}",
      "mobile.margin":   "{space.4}"
    }
  },

  "z": {
    "base":     "0",
    "raised":   "10",
    "sticky":   "100",
    "overlay":  "1000",
    "modal":    "1100",
    "toast":    "1200",
    "tooltip":  "1300"
  }
}
