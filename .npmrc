# next@15.0.3 declares a strict React peer (^18.2.0 || a specific 19 RC) and rejects
# stable react@19.x under npm's strict peer resolution, breaking `npm ci` on CI and Vercel.
# The combo works at runtime; relax peer resolution so installs succeed.
# Future cleanup: bump next to >=15.1 (broadened react peer) and drop this flag.
legacy-peer-deps=true
