# Database — Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Resend — transactional email
RESEND_API_KEY=re_xxx
WAITLIST_FROM_EMAIL="Qintar <hello@qintar.com>"

# PostHog — analytics (client-side keys are public; safe in NEXT_PUBLIC_)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side PostHog (same project key is fine; used for server-side capture)
POSTHOG_API_KEY=phc_xxx

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- HubSpot integration (QIN-20) ---
# From a HubSpot developer app (https://developers.hubspot.com -> Apps -> Auth).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must EXACTLY match a redirect URL registered on the app's Auth tab.
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/callback
# Optional: override the requested OAuth scopes (space-separated).
# HUBSPOT_SCOPES="oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read"

# AES-256-GCM key for encrypting OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret to authorize manual sync triggers (POST /api/hubspot/sync?secret=...)
# and the status endpoint. Generate with: openssl rand -hex 32
SYNC_TRIGGER_SECRET=
# Set on Vercel so the scheduled cron can authenticate (can equal SYNC_TRIGGER_SECRET).
# CRON_SECRET=
