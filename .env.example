# Database — Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Resend — transactional email
RESEND_API_KEY=re_xxx
WAITLIST_FROM_EMAIL="Qintar <hello@qintar.com>"

# PostHog — analytics (client-side keys are public; safe in NEXT_PUBLIC_)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-side PostHog (same project key is fine; used for server-side capture)
POSTHOG_API_KEY=phc_xxx

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- HubSpot integration (QIN-20) ---
# From a HubSpot developer app (https://developers.hubspot.com -> Apps -> Auth).
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must EXACTLY match a redirect URL registered on the app's Auth tab.
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/hubspot/callback
# Optional: override the requested OAuth scopes (space-separated).
# HUBSPOT_SCOPES="oauth crm.objects.contacts.read crm.objects.companies.read crm.objects.deals.read"

# AES-256-GCM key for encrypting OAuth tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Shared secret to authorize manual sync triggers (POST /api/hubspot/sync?secret=...)
# and the status endpoint. Generate with: openssl rand -hex 32
SYNC_TRIGGER_SECRET=
# Set on Vercel so the scheduled cron can authenticate (can equal SYNC_TRIGGER_SECRET).
# CRON_SECRET=

# --- Stripe billing (QIN-24) ---
# From the Stripe dashboard -> Developers -> API keys. Use TEST keys (sk_test_…)
# until the end-to-end flow is verified, then swap to LIVE keys (sk_live_…).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Local: `stripe listen --forward-to
# localhost:3000/api/billing/webhook` prints it. Prod: copy from the webhook
# endpoint you create in the dashboard pointing at /api/billing/webhook.
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price ids for the three tiers. Create one Product per tier
# in Stripe ($49 / $499 / $1,499) with a monthly recurring Price, then paste
# each Price id (price_…) here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=
# Server-to-server / internal secret for billing endpoints (cron, tooling).
# End users now authenticate via the session (below); this is only the
# admin/automation fallback. Generate with: openssl rand -hex 32
# (Falls back to SYNC_TRIGGER_SECRET if unset.)
BILLING_ADMIN_SECRET=

# --- Auth & onboarding (QIN-25) ---
# Signs the session cookie (HMAC-SHA256). REQUIRED to sign up / sign in.
# Generate with: openssl rand -hex 32. Falls back to TOKEN_ENCRYPTION_KEY if
# unset, but set a dedicated value in production.
AUTH_SESSION_SECRET=
# Entitlement enforcement on recurring sync / digest delivery. Default OFF so
# keyless staging sync is unaffected. Set to "true" to gate orgs that have
# entered billing but aren't actively paying. ("true" | anything-else=off)
ENFORCE_ENTITLEMENTS=false
# Optional Slack OAuth app (operator) — onboarding ships Slack as a deferrable
# step; when set, the connect step shows "Add to Slack".
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# --- Auth provider swap to Clerk (production target; optional) ---
# When these are set, AUTH_PROVIDER flips to "clerk" (see src/lib/auth/index.ts)
# and getSession() should read Clerk's session. Until then the built-in
# password+cookie provider is active, so onboarding works with no IdP keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
